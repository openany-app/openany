{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openany",
  "identifier": "de.openany.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "openany",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://tile.openstreetmap.org; media-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/inhalte/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "openany",
    "copyright": "Copyright © 2026 openany.de",
    "category": "Productivity",
    "createUpdaterArtifacts": true,
    "shortDescription": "Notes, calendar, files, messages and projects – on your device",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxREIyN0ZEODBFM0Y0RUMKUldUczlPT0EvU2Zic2VhbGNrcjU5SDhzQ0dnSkZ4K0VVSDg5bGJEakxReW9XdEtrZHRzMVNCamQK",
      "endpoints": [
        "https://github.com/openany-app/openany/releases/download/desktop-aktuell/{{target}}-{{arch}}.json"
      ]
    }
  }
}
